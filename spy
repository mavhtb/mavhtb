-- QTE Remote Spy (mobile friendly)
-- Logs what your client SENDS ([OUT]) and what the server SENDS YOU ([IN]).
-- Turn OFF the farm scripts first, then do each QTE by hand and copy the log.

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

-- stop any previous copy
if getgenv().QTESpy and getgenv().QTESpy.Stop then
    pcall(getgenv().QTESpy.Stop)
end

--------------------------------------------------------------------
-- CONFIG
--------------------------------------------------------------------
local CFG = {
    FilterQTE = true,   -- true: only log calls that mention "QTE". false: log everything
    MaxLines = 300,     -- keeps the most recent lines
}

--------------------------------------------------------------------
-- LOG BUFFER
--------------------------------------------------------------------
local alive = true
local conns = {}
local lines = {}
local startTime = tick()
local counterLabel, hookLabel -- UI labels, set below
local hookText = "Outgoing hook: starting..."

local function updateCounter()
    if counterLabel then counterLabel.Text = "Logged lines: " .. #lines end
end

local function ser(v, depth)
    depth = depth or 0
    local t = typeof(v)
    if t == "string" then return string.format("%q", v) end
    if t == "table" then
        if depth > 3 then return "{...}" end
        local parts = {}
        for k, val in pairs(v) do
            table.insert(parts, "[" .. ser(k, depth + 1) .. "]=" .. ser(val, depth + 1))
        end
        return "{" .. table.concat(parts, ", ") .. "}"
    end
    if t == "Instance" then return "Instance<" .. v:GetFullName() .. ">" end
    return tostring(v)
end

local function fmtArgs(args)
    local out = {}
    for i = 1, args.n do out[i] = ser(args[i]) end
    return table.concat(out, ", ")
end

local function wanted(...)
    if not CFG.FilterQTE then return true end
    for _, text in ipairs({ ... }) do
        if tostring(text):find("QTE", 1, true) then return true end
    end
    return false
end

local function addLine(line)
    table.insert(lines, line)
    if #lines > CFG.MaxLines then table.remove(lines, 1) end
    print(line)
    updateCounter()
end

local function stamp()
    return ("%.2f"):format(tick() - startTime)
end

--------------------------------------------------------------------
-- UI (built first so it always shows, even if hooking fails)
--------------------------------------------------------------------
local gui = Instance.new("ScreenGui")
gui.Name = "QTESpyGui"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 999
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

local function tryParent(getParent)
    local ok, parent = pcall(getParent)
    if ok and parent then
        local ok2 = pcall(function() gui.Parent = parent end)
        return ok2 and gui.Parent ~= nil
    end
    return false
end

if not (gethui and tryParent(gethui))
    and not tryParent(function() return game:GetService("CoreGui") end)
    and not tryParent(function() return LocalPlayer:WaitForChild("PlayerGui", 5) end) then
    warn("[Spy] Could not parent the panel anywhere - output will only go to the console")
end

