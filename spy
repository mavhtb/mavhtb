local function refreshFilter()
    btnFilter.Text = CFG.FilterQTE and "Filter: QTE only" or "Filter: EVERYTHING"
    btnFilter.BackgroundColor3 = CFG.FilterQTE and Color3.fromRGB(46, 150, 80) or Color3.fromRGB(150, 110, 40)
end
refreshFilter()

btnFilter.MouseButton1Click:Connect(function()
    CFG.FilterQTE = not CFG.FilterQTE
    refreshFilter()
end)

btnClear.MouseButton1Click:Connect(function()
    lines = {}
    updateCounter()
end)

btnCopy.MouseButton1Click:Connect(function()
    if #lines == 0 then
        counterLabel.Text = "Nothing logged yet"
        return
    end
    local text = table.concat(lines, "\n")
    if setclipboard then
        local ok = pcall(setclipboard, text)
        counterLabel.Text = ok and ("Copied " .. #lines .. " lines!") or "Copy failed - check console"
    else
        counterLabel.Text = "No clipboard support - copy from the console"
        print(text)
    end
end)

-- drag (mouse or touch), kept on screen
do
    local dragInput, dragStart, startX, startY
    table.insert(conns, title.InputBegan:Connect(function(input)
        local t = input.UserInputType
        if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
            dragInput = input
            dragStart = input.Position
            startX, startY = frame.AbsolutePosition.X, frame.AbsolutePosition.Y
        end
    end))
    table.insert(conns, UIS.InputChanged:Connect(function(input)
        if not dragInput then return end
        local touchMove = (input == dragInput and input.UserInputType == Enum.UserInputType.Touch)
        local mouseMove = (input.UserInputType == Enum.UserInputType.MouseMovement
            and dragInput.UserInputType == Enum.UserInputType.MouseButton1)
        if touchMove or mouseMove then
            local d = input.Position - dragStart
            local vp = gui.AbsoluteSize
            local x = math.clamp(startX + d.X, 0, math.max(0, vp.X - frame.AbsoluteSize.X))
            local y = math.clamp(startY + d.Y, 0, math.max(0, vp.Y - frame.AbsoluteSize.Y))
            frame.Position = UDim2.fromOffset(x, y)
        end
    end))
    table.insert(conns, UIS.InputEnded:Connect(function(input)
        if dragInput and (input == dragInput
            or (input.UserInputType == Enum.UserInputType.MouseButton1
                and dragInput.UserInputType == Enum.UserInputType.MouseButton1)) then
            dragInput = nil
        end
    end))
end

getgenv().QTESpy = {
    Stop = function()
        alive = false
        getgenv().QTESpyOut = nil
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        gui:Destroy()
    end,
}

btnClose.MouseButton1Click:Connect(function()
    getgenv().QTESpy.Stop()
end)

print("[Spy] Panel created. Setting up hooks...")

--------------------------------------------------------------------
-- OUTGOING (client -> server)
--------------------------------------------------------------------
local function setHookText(t)
    hookText = t
    if hookLabel then hookLabel.Text = t end
end

-- the namecall hook is installed once per game session and just hands calls to whichever
-- copy of the spy is currently running, so re-running the script never stacks hooks
getgenv().QTESpyOut = function(self, method, args)
    local text = fmtArgs(args)
    if wanted(text, self.Name) then
        addLine(("[%s] [OUT] %s:%s(%s)"):format(stamp(), self:GetFullName(), method, text))
    end
end

if getgenv().QTESpyHooked then
    setHookText("Outgoing hook: active")
else
    local ok, err = pcall(function()
        assert(hookmetamethod and getnamecallmethod and newcclosure,
            "executor is missing hookmetamethod/getnamecallmethod/newcclosure")
        local old
        old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if (method == "FireServer" or method == "InvokeServer")
                and typeof(self) == "Instance"
                and (self:IsA("RemoteEvent") or self:IsA("RemoteFunction")) then
                local handler = getgenv().QTESpyOut
                if handler then
                    local args = table.pack(...)
                    task.spawn(handler, self, method, args)
                end
            end
            return old(self, ...)
        end))
    end)
    if ok then
        getgenv().QTESpyHooked = true
        setHookText("Outgoing hook: active")
    else
        warn("[Spy] Outgoing hook failed: " .. tostring(err))
        setHookText("Outgoing hook: FAILED (IN only)")
    end
end

--------------------------------------------------------------------
-- INCOMING (server -> client)
--------------------------------------------------------------------
local hooked = 0
pcall(function()
    for _, d in ipairs(RS:GetDescendants()) do
        if d:IsA("RemoteEvent") then
            table.insert(conns, d.OnClientEvent:Connect(function(...)
                if not alive then return end
                local args = table.pack(...)
                local text = fmtArgs(args)
                if wanted(text, d.Name) then
                    addLine(("[%s] [IN]  %s(%s)"):format(stamp(), d:GetFullName(), text))
                end
            end))
            hooked = hooked + 1
        end
    end
end)

print(("[Spy] Ready. Listening on %d incoming remotes. %s"):format(hooked, hookText))
