--------------------------------------------------------------------
-- CONFIG
--------------------------------------------------------------------
local CFG = {
    HideNoise = true,   -- true: skip the spammy remotes listed in IGNORE below. false: log everything
    MaxLines = 300,     -- keeps the most recent lines
    PrintToConsole = false, -- printing every line to the console is slow on mobile; use Copy log instead
}

--------------------------------------------------------------------
-- LOG BUFFER
--------------------------------------------------------------------
local alive = true
local conns = {}
local lines = {}
local startTime = tick()
local counterLabel, hookLabel -- UI labels, set below
local hookText = "Outgoing: OFF (tap Hook A or B)"

local function updateCounter()
    if counterLabel then counterLabel.Text = "Logged lines: " .. #lines end
end

local function ser(v, depth)
    depth = depth or 0
    local t = typeof(v)
    if t == "string" then return string.format("%q", v) end
    if t == "table" then
        if depth > 3 then return "{...}" end
        local parts = {}
        for k, val in pairs(v) do
            table.insert(parts, "[" .. ser(k, depth + 1) .. "]=" .. ser(val, depth + 1))
        end
        return "{" .. table.concat(parts, ", ") .. "}"
    end
    if t == "Instance" then return "Instance<" .. v:GetFullName() .. ">" end
    return tostring(v)
end

local function fmtArgs(args)
    local out = {}
    for i = 1, args.n do out[i] = ser(args[i]) end
    return table.concat(out, ", ")
end

local function wanted(...)
    if not CFG.HideNoise then return true end
    for _, text in ipairs({ ... }) do
        if tostring(text):find("QTE", 1, true) then return true end
    end
    return false
end

local function addLine(line)
    table.insert(lines, line)
    if #lines > CFG.MaxLines then table.remove(lines, 1) end
    if CFG.PrintToConsole then print(line) end
    updateCounter()
end

-- remotes that fire constantly during fights and just bury the QTE lines
local IGNORE = {
    UpdateItems = true, UpdateBuffVisuals = true, UpdateSkills = true, UpdateSkillCDs = true,
    DuskyClientRemote = true, MessageSent = true, UpdateTurnCount = true,
    StartAction = true, EndAction = true, AttackIndicate = true,
}

-- cheap check done BEFORE the (slow) full serialization
local function quickMatch(name, args)
    if CFG.HideNoise and IGNORE[name] then return false end
    return true
end

