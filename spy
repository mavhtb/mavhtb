--------------------------------------------------------------------
-- OUTGOING (client -> server) - OFF until you tap a hook button
--------------------------------------------------------------------
local function setHookText(t)
    hookText = t
    if hookLabel then hookLabel.Text = t end
end

-- hooks stay installed until you rejoin the game, so they hand calls to whichever copy of
-- the spy is running (getgenv().QTESpyOut). Re-running the script never stacks them.
getgenv().QTESpyOut = function(self, method, args)
    if quickMatch(self.Name, args) then
        addLine(("[%s] [OUT] %s:%s(%s)"):format(stamp(), self:GetFullName(), method, fmtArgs(args)))
    end
end

-- Hook A: __namecall hook (catches remote:FireServer(...) style calls)
local function installA()
    if getgenv().QTESpyHooked then return true end
    local ok, err = pcall(function()
        assert(hookmetamethod and getnamecallmethod and newcclosure,
            "executor is missing hookmetamethod/getnamecallmethod/newcclosure")
        local old
        old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if (method == "FireServer" or method == "InvokeServer") and typeof(self) == "Instance" then
                local handler = getgenv().QTESpyOut
                if handler then
                    task.spawn(handler, self, method, table.pack(...))
                end
            end
            return old(self, ...)
        end))
    end)
    if ok then getgenv().QTESpyHooked = true else warn("[Spy] Hook A failed: " .. tostring(err)) end
    return ok
end

-- Hook B: hooks FireServer / InvokeServer directly. Lighter on the rest of the game.
local function installB()
    if getgenv().QTESpyHookedB then return true end
    local ok, err = pcall(function()
        assert(hookfunction and newcclosure, "executor is missing hookfunction/newcclosure")
        local re = Instance.new("RemoteEvent")
        local rf = Instance.new("RemoteFunction")
        local oldFire, oldInvoke
        oldFire = hookfunction(re.FireServer, newcclosure(function(self, ...)
            local handler = getgenv().QTESpyOut
            if handler and typeof(self) == "Instance" then
                task.spawn(handler, self, "FireServer", table.pack(...))
            end
            return oldFire(self, ...)
        end))
        oldInvoke = hookfunction(rf.InvokeServer, newcclosure(function(self, ...)
            local handler = getgenv().QTESpyOut
            if handler and typeof(self) == "Instance" then
                task.spawn(handler, self, "InvokeServer", table.pack(...))
            end
            return oldInvoke(self, ...)
        end))
    end)
    if ok then getgenv().QTESpyHookedB = true else warn("[Spy] Hook B failed: " .. tostring(err)) end
    return ok
end

local function updateHookButtons()
    local a, b = getgenv().QTESpyHooked, getgenv().QTESpyHookedB
    btnHookA.Text = "Hook A: " .. (a and "ON" or "OFF")
    btnHookA.BackgroundColor3 = a and Color3.fromRGB(46, 150, 80) or Color3.fromRGB(80, 80, 92)
    btnHookB.Text = "Hook B: " .. (b and "ON" or "OFF")
    btnHookB.BackgroundColor3 = b and Color3.fromRGB(46, 150, 80) or Color3.fromRGB(80, 80, 92)
end

if getgenv().QTESpyHooked or getgenv().QTESpyHookedB then
    setHookText("Outgoing: a hook is already active")
end
updateHookButtons()

btnHookA.MouseButton1Click:Connect(function()
    if getgenv().QTESpyHooked then return end
    setHookText("Installing hook A...")
    task.wait(0.1)
    local ok = installA()
    setHookText(ok and "Outgoing: hook A active" or "Hook A failed (see console)")
    updateHookButtons()
end)

btnHookB.MouseButton1Click:Connect(function()
    if getgenv().QTESpyHookedB then return end
    setHookText("Installing hook B...")
    task.wait(0.1)
    local ok = installB()
    setHookText(ok and "Outgoing: hook B active" or "Hook B failed (see console)")
    updateHookButtons()
end)

--------------------------------------------------------------------
-- INCOMING (server -> client)
--------------------------------------------------------------------
local hooked = 0
pcall(function()
    for _, d in ipairs(RS:GetDescendants()) do
        if d:IsA("RemoteEvent") then
            table.insert(conns, d.OnClientEvent:Connect(function(...)
                if not alive then return end
                local args = table.pack(...)
                if quickMatch(d.Name, args) then
                    addLine(("[%s] [IN]  %s(%s)"):format(stamp(), d:GetFullName(), fmtArgs(args)))
                end
            end))
            hooked = hooked + 1
        end
    end
end)

print(("[Spy] Ready. Listening on %d incoming remotes. %s"):format(hooked, hookText))
