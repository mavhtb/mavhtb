-- drag (mouse or touch), kept on screen
do
    local dragInput, dragStart, startX, startY
    table.insert(conns, title.InputBegan:Connect(function(input)
        local t = input.UserInputType
        if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
            dragInput = input
            dragStart = input.Position
            startX, startY = frame.AbsolutePosition.X, frame.AbsolutePosition.Y
        end
    end))
    table.insert(conns, UIS.InputChanged:Connect(function(input)
        if not dragInput then return end
        local touchMove = (input == dragInput and input.UserInputType == Enum.UserInputType.Touch)
        local mouseMove = (input.UserInputType == Enum.UserInputType.MouseMovement
            and dragInput.UserInputType == Enum.UserInputType.MouseButton1)
        if touchMove or mouseMove then
            local d = input.Position - dragStart
            local vp = gui.AbsoluteSize
            local x = math.clamp(startX + d.X, 0, math.max(0, vp.X - frame.AbsoluteSize.X))
            local y = math.clamp(startY + d.Y, 0, math.max(0, vp.Y - frame.AbsoluteSize.Y))
            frame.Position = UDim2.fromOffset(x, y)
        end
    end))
    table.insert(conns, UIS.InputEnded:Connect(function(input)
        if dragInput and (input == dragInput
            or (input.UserInputType == Enum.UserInputType.MouseButton1
                and dragInput.UserInputType == Enum.UserInputType.MouseButton1)) then
            dragInput = nil
        end
    end))
end

