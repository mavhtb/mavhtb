    pcall(getgenv().HorseFarm.Stop)
end

--------------------------------------------------------------------
-- CONFIG
--------------------------------------------------------------------
local CFG = {
    AutoQuest = false,
    AutoRace = false,

    GateDelay = 0.15,      -- pause after each gate is accepted
    GateTimeout = 3,       -- seconds to wait for the server to accept a gate
    MaxRetries = 8,        -- retries on a single gate before the race bot gives up

    AntiIdle = true,       -- stops Roblox's idle kick while you're AFK

    Nudge = true,          -- after teleporting to a gate, shift through it a little and back
    NudgeDistance = 3,     -- studs to shift along the gate's forward axis
    PreFireDelay = 0.1,    -- pause between arriving at a gate and firing the remote

    QuestRetry = 10,       -- min seconds between quest click attempts
    QuestTimeout = 300,    -- if no FinishQuest after this long, assume the quest is over
    BoardOffset = Vector3.new(7, 0, 0), -- where to stand next to the paper

    -- minimum seconds a race should take, matched against the course name (case-insensitive)
    MinRaceTime = {
        ["waving sands"] = 27,
        ["the crossing"] = 0,
        ["deeproot canopy"] = 0,
    },
}

local function log(...) print("[HorseFarm]", ...) end

