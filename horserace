-- keep a GUI object fully on screen
local function clampToScreen(obj, x, y)
    local vp = gui.AbsoluteSize
    local w, h = obj.AbsoluteSize.X, obj.AbsoluteSize.Y
    x = math.clamp(x, 0, math.max(0, vp.X - w))
    y = math.clamp(y, 0, math.max(0, vp.Y - h))
    return x, y
end

-- drag `target` by grabbing `handle` (works with mouse and touch).
-- onTap fires if the handle was pressed and released without really moving.
local function makeDraggable(handle, target, onTap)
    local dragInput, dragStart, startX, startY, moved
    table.insert(conns, handle.InputBegan:Connect(function(input)
        local t = input.UserInputType
        if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
            dragInput = input
            dragStart = input.Position
            startX, startY = target.AbsolutePosition.X, target.AbsolutePosition.Y
            moved = false
        end
    end))
    table.insert(conns, UIS.InputChanged:Connect(function(input)
        if not dragInput then return end
        local isTouchMove = (input == dragInput and input.UserInputType == Enum.UserInputType.Touch)
        local isMouseMove = (input.UserInputType == Enum.UserInputType.MouseMovement
            and dragInput.UserInputType == Enum.UserInputType.MouseButton1)
        if isTouchMove or isMouseMove then
            local d = input.Position - dragStart
            if d.Magnitude > 6 then moved = true end
            if moved then
                local x, y = clampToScreen(target, startX + d.X, startY + d.Y)
                target.Position = UDim2.fromOffset(x, y)
            end
        end
    end))
    table.insert(conns, UIS.InputEnded:Connect(function(input)
        if dragInput and (input == dragInput
            or (input.UserInputType == Enum.UserInputType.MouseButton1
                and dragInput.UserInputType == Enum.UserInputType.MouseButton1)) then
            local wasTap = not moved
            dragInput = nil
            if wasTap and onTap then onTap() end
        end
    end))
end

makeDraggable(title, frame)

-- minimize / restore. The icon and panel swap places so it comes back where you left it.
local function minimize()
    local x, y = clampToScreen(icon, frame.AbsolutePosition.X, frame.AbsolutePosition.Y)
    icon.Position = UDim2.fromOffset(x, y)
    frame.Visible = false
    icon.Visible = true
end

local function restore()
    local x, y = clampToScreen(frame, icon.AbsolutePosition.X, icon.AbsolutePosition.Y)
    frame.Position = UDim2.fromOffset(x, y)
    icon.Visible = false
    frame.Visible = true
end

