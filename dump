-- COLLECT
--------------------------------------------------------------------
local function decompileSafe(scr)
    local ok, src = pcall(decompile, scr)
    if ok and type(src) == "string" then return src end
    return nil
end

local function lastLines(src, n)
    local lines = {}
    for l in (src .. "\n"):gmatch("(.-)\n") do lines[#lines + 1] = l end
    local parts = {}
    for i = math.max(1, #lines - n + 1), #lines do
        parts[#parts + 1] = ("%d: %s"):format(i, lines[i])
    end
    return table.concat(parts, "\n"), #lines
end

local function findCombatHandle()
    local remote = RS:WaitForChild("Remotes"):WaitForChild("Information"):WaitForChild("RemoteFunction")
    local ok, conns = pcall(getconnections, remote.OnClientEvent)
    if not (ok and type(conns) == "table") then return nil end
    for _, c in ipairs(conns) do
        local okf, fn = pcall(function() return c.Function end)
        if okf and type(fn) == "function" then
            local scr
            if getscriptfromfunction then
                local ok2, s = pcall(getscriptfromfunction, fn)
                if ok2 then scr = s end
            end
            if not scr and getfenv then
                local ok2, env = pcall(getfenv, fn)
                if ok2 and type(env) == "table" then scr = rawget(env, "script") end
            end
            if scr and scr.Name == "CombatHandle" then return scr end
        end
    end
    return nil
end

local function buildParts(entries)
    local parts = {}
    local cur, curLabels, curLen = {}, {}, 0
    local function flush()
        if #cur > 0 then
            parts[#parts + 1] = { text = table.concat(cur, "\n\n"), labels = curLabels }
            cur, curLabels, curLen = {}, {}, 0
        end
    end
    for _, e in ipairs(entries) do
        local text = "##### " .. e.label .. "\n" .. e.body
        if #text > CAP then
            flush()
            local chunk, len, idx = {}, 0, 1
            for line in (text .. "\n"):gmatch("(.-)\n") do
                if len + #line + 1 > CAP and #chunk > 0 then
                    parts[#parts + 1] = { text = table.concat(chunk, "\n"), labels = { e.label .. " (" .. idx .. ")" } }
                    chunk, len, idx = {}, 0, idx + 1
                end
                chunk[#chunk + 1] = line
                len = len + #line + 1
            end
            if #chunk > 0 then
                parts[#parts + 1] = { text = table.concat(chunk, "\n"), labels = { e.label .. " (" .. idx .. ")" } }
            end
        else
            if curLen + #text > CAP then flush() end
            cur[#cur + 1] = text
            curLabels[#curLabels + 1] = e.label
            curLen = curLen + #text + 2
        end
    end
    flush()
    return parts
end

task.spawn(function()
    if not (getconnections and decompile) then
        setStatus("This executor is missing getconnections or decompile")
        return
    end

    local combat = findCombatHandle()
    if not combat then
        setStatus("Could not find CombatHandle")
        return
    end

    local entries = {}

    -- entry 1: layout of CombatHandle + how it ends (where the reply is sent)
    local info = { "CombatHandle: " .. combat:GetFullName(), "", "--- scripts inside ---" }
    local modules = {}
    for _, d in ipairs(combat:GetDescendants()) do
        if d:IsA("LuaSourceContainer") then
            info[#info + 1] = d.ClassName .. "  " .. d.Name
            if d:IsA("ModuleScript") then modules[#modules + 1] = d end
        end
    end
    setStatus("Reading CombatHandle...")
    local mainSrc = decompileSafe(combat)
    if mainSrc then
        local tail, total = lastLines(mainSrc, TAIL_LINES)
        info[#info + 1] = ""
        info[#info + 1] = ("--- last %d of %d lines of CombatHandle ---"):format(TAIL_LINES, total)
        info[#info + 1] = tail
    else
        info[#info + 1] = "(CombatHandle decompile failed)"
    end
    entries[#entries + 1] = { label = "CombatHandle overview", body = table.concat(info, "\n") }

    -- QTE modules first (Dodge at the very front), then everything else
    table.sort(modules, function(a, b)
        local qa, qb = a.Name:find("QTE", 1, true) ~= nil, b.Name:find("QTE", 1, true) ~= nil
        if qa ~= qb then return qa end
        local da, db = a.Name:lower():find("dodge", 1, true) ~= nil, b.Name:lower():find("dodge", 1, true) ~= nil
        if da ~= db then return da end
        return a.Name < b.Name
    end)

    for i, m in ipairs(modules) do
        setStatus(("Reading modules %d/%d: %s"):format(i, #modules, m.Name))
        local src = decompileSafe(m)
        entries[#entries + 1] = { label = m.Name, body = src or "(decompile failed)" }
        task.wait() -- keep the game responsive
    end

    local parts = buildParts(entries)
    setStatus(("Done: %d parts. Tap a button, then paste it in chat. Do each part in order."):format(#parts))

    for i, part in ipairs(parts) do
        local label = table.concat(part.labels, ", ")
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(1, -4, 0, 36)
        b.BackgroundColor3 = Color3.fromRGB(45, 110, 160)
        b.BorderSizePixel = 0
        b.TextColor3 = Color3.new(1, 1, 1)
        b.Font = Enum.Font.GothamBold
        b.TextSize = 11
        b.TextWrapped = true
        b.TextTruncate = Enum.TextTruncate.AtEnd
        b.Text = ("Copy part %d/%d: %s"):format(i, #parts, label)
        b.LayoutOrder = i
        b.Parent = list
        corner(b, 6)
        b.MouseButton1Click:Connect(function()
            if setclipboard then
                local ok = pcall(setclipboard, part.text)
                setStatus(ok and ("Copied part %d/%d (%d chars)"):format(i, #parts, #part.text) or "Copy failed - see console")
                b.BackgroundColor3 = Color3.fromRGB(46, 150, 80)
            else
                print(part.text)
                setStatus("No clipboard support - part printed to the console")
            end
        end)
    end

    print(("[Dump3] ready: %d parts"):format(#parts))
end)
