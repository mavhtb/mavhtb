-- Targeted dump: only the parts of the game's client code that deal with the dodge QTE
-- (Nonce / Glint / DodgeWindow / BlockWindow / Seed / Sweep / aliases), with a few lines around each.
-- Nothing is sent to the server. Run once, then paste the result.

local RS = game:GetService("ReplicatedStorage")

local PATTERNS = {
    "Nonce", "Glint", "DodgeWindow", "BlockWindow", "DodgeWidth", "Sweep", "Seed", "Layout",
    "UIProfile", "applyAliases", "Alias", "alias",
}
local RADIUS = 14
local MAX_CHARS = 16000

local out = {}
local function add(s) out[#out + 1] = tostring(s) end

local function windows(src)
    local lines = {}
    for l in (src .. "\n"):gmatch("(.-)\n") do lines[#lines + 1] = l end

    local keep, hits = {}, 0
    for i, l in ipairs(lines) do
        for _, p in ipairs(PATTERNS) do
            if l:find(p, 1, true) then
                hits = hits + 1
                for j = math.max(1, i - RADIUS), math.min(#lines, i + RADIUS) do keep[j] = true end
                break
            end
        end
    end

    local parts, last = {}, 0
    for i = 1, #lines do
        if keep[i] then
            if i > last + 1 then parts[#parts + 1] = "-- ..." end
            parts[#parts + 1] = ("%d: %s"):format(i, lines[i])
            last = i
        end
    end
    return table.concat(parts, "\n"), #lines, hits
end

local remote = RS:WaitForChild("Remotes"):WaitForChild("Information"):WaitForChild("RemoteFunction")
add("Remote: " .. remote:GetFullName() .. " (" .. remote.ClassName .. ")")

if not (getconnections and decompile) then
    add("This executor is missing getconnections or decompile")
else
    local scripts, seenScript = {}, {}
    local ok, conns = pcall(getconnections, remote.OnClientEvent)
    if ok and type(conns) == "table" then
        for _, c in ipairs(conns) do
            local okf, fn = pcall(function() return c.Function end)
            if okf and type(fn) == "function" then
                local scr
                if getscriptfromfunction then
                    local ok2, s = pcall(getscriptfromfunction, fn)
                    if ok2 then scr = s end
                end
                if not scr and getfenv then
                    local ok2, env = pcall(getfenv, fn)
                    if ok2 and type(env) == "table" then scr = rawget(env, "script") end
                end
                if scr and not seenScript[scr] then
                    seenScript[scr] = true
                    scripts[#scripts + 1] = scr
                end
            end
        end
    end

    add("Scripts with handlers on this remote: " .. #scripts)
    for _, scr in ipairs(scripts) do
        add("")
        add("##### " .. scr:GetFullName())
        local okd, src = pcall(decompile, scr)
        if okd and type(src) == "string" then
            local text, total, hits = windows(src)
            add(("(%d lines, %d matching lines)"):format(total, hits))
            if hits > 0 then add(text) end
        else
            add("(decompile failed)")
        end
    end
end

local text = table.concat(out, "\n")
if #text > MAX_CHARS then
    text = text:sub(1, MAX_CHARS) .. "\n-- (cut off at " .. MAX_CHARS .. " chars)"
end

if setclipboard then
    local ok = pcall(setclipboard, text)
    print(("[Dump2] %d characters %s"):format(#text, ok and "copied to clipboard" or "ready (clipboard failed)"))
else
    print("[Dump2] No clipboard support - output below")
    print(text)
end
